# Domain — both subdomains must point at the client server IP
CLIENT_DOMAIN=client.yourdomain.com

# Ingest token — random 32+ char secret, shared with app env vars
OBS_INGEST_TOKEN=changeme_generate_with_openssl_rand_hex_32

# PostgreSQL (if applicable) — read-only OTel monitoring user
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_OTEL_USER=otel_reader
POSTGRES_OTEL_PASSWORD=changeme
POSTGRES_DB=mydb

# Redis (if applicable)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB (if applicable)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_OTEL_USER=otel_reader
MONGO_OTEL_PASSWORD=changeme

# PostHog project API key — get from PostHog UI after first deploy
POSTHOG_PROJECT_API_KEY=phc_changeme

# SigNoz admin password
SIGNOZ_ADMIN_EMAIL=admin@osillation.io
SIGNOZ_ADMIN_PASSWORD=changeme
